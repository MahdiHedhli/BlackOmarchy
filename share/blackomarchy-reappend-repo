#!/usr/bin/env bash
# Root-owned helper. Re-append [blackarch] after Omarchy rewrites pacman.conf.
# BlackArch stays last so core/extra/omarchy keep package-name priority.
set -euo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

LIB=/usr/local/share/blackomarchy/lib
if [[ ! -f $LIB/common.sh ]]; then
  printf 'blackomarchy-reappend-repo: Black omARCHy is not installed\n' >&2
  exit 1
fi
# shellcheck disable=SC1091
source "$LIB/common.sh"
load_paths
# shellcheck disable=SC1091
source "$LIB/pacman.sh"

if [[ ! -f /etc/pacman.d/blackarch-mirrorlist ]]; then
  printf 'blackomarchy-reappend-repo: blackarch-mirrorlist missing\n' >&2
  exit 1
fi

require_omarchy_repos
append_blackarch_stanza
assert_single_blackarch
