#!/usr/bin/env bash
# Overlay the SDDM greeter wordmark only. Leaves Main.qml and Omarchy
# colors alone. Inverse of this helper is a restore of the backed-up logo.
set -euo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

STATE=${BLACKOMARCHY_STATE_DIR:-/var/lib/blackomarchy}
SHARE=${BLACKOMARCHY_SHARE_DIR:-/usr/local/share/blackomarchy}
LOGO="$SHARE/share/branding/login-logo.png"
if [[ ! -f $LOGO ]]; then
  LOGO="$SHARE/branding/login-logo.png"
fi
DEST=/usr/share/sddm/themes/omarchy/logo.png
BACKUP="$STATE/sddm-logo.omarchy.png"
STOCK=/usr/share/omarchy/default/sddm/omarchy/logo.png

mode=${1:-apply}

case $mode in
  apply)
    [[ -f /var/lib/blackomarchy/version ]] || exit 0
    [[ -f $LOGO && -f $DEST ]] || exit 0
    mkdir -p "$STATE"
    if [[ ! -f $BACKUP ]]; then
      cp -a "$DEST" "$BACKUP"
    fi
    install -m 0644 "$LOGO" "$DEST"
    ;;
  restore)
    [[ -f $DEST ]] || exit 0
    if [[ -f $BACKUP ]]; then
      cp -a "$BACKUP" "$DEST"
    elif [[ -f $STOCK ]]; then
      cp -a "$STOCK" "$DEST"
    fi
    ;;
  *)
    printf 'usage: blackomarchy-apply-login-branding [apply|restore]\n' >&2
    exit 2
    ;;
esac
