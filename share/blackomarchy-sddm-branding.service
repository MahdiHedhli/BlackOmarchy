[Unit]
Description=Black omARCHy SDDM login wordmark
Documentation=https://github.com/MahdiHedhli/BlackOmarchy
Before=sddm.service display-manager.service
After=local-fs.target
ConditionPathExists=/var/lib/blackomarchy/version

[Service]
Type=oneshot
# SDDM only. Plymouth is baked into initramfs by `apply` at install or
# update; rebuilding it here would delay the greeter and miss this boot.
ExecStart=/usr/local/sbin/blackomarchy-apply-login-branding apply-sddm
RemainAfterExit=yes

[Install]
WantedBy=sddm.service display-manager.service
